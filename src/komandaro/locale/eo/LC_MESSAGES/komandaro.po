#: src/komandaro/command.py:71
msgid "Unnamed command"
msgstr "Sennoma komando"

#: src/komandaro/command.py:91
#, python-format
msgid "Command %(name)s has already been executed"
msgstr "La komando %(name)s jam estis plenumita"

#: src/komandaro/command.py:98
#, python-format
msgid "Command %(name)s cannot be undone in its current state"
msgstr "La komando %(name)s ne povas esti malfarita en sia nuna stato"

#: src/komandaro/command.py:104
#, python-format
msgid "Command %(name)s cannot be redone in its current state"
msgstr "La komando %(name)s ne povas esti refarita en sia nuna stato"

#: src/komandaro/command.py:251
msgid "Macro"
msgstr "Makroo"

#: src/komandaro/command.py:252
msgid "A sequence of commands executed as one"
msgstr "Sinsekvo de komandoj plenumataj kiel unu"

#: src/komandaro/command.py:259 src/komandaro/command.py:263
#, python-format
msgid "Macro %(name)s cannot be modified once executed"
msgstr "La makroo %(name)s ne plu povas esti ŝanĝita post plenumo"

#: src/komandaro/invoker.py:101
msgid "This invoker has no registry"
msgstr "Ĉi tiu alvokanto ne havas registron"

#: src/komandaro/invoker.py:124
msgid "Nothing to undo"
msgstr "Nenio malfarenda"

#: src/komandaro/invoker.py:138
msgid "Nothing to redo"
msgstr "Nenio refarenda"

#: src/komandaro/registry.py:91
#, python-format
msgid "Command %(id)s is already registered"
msgstr "La komando %(id)s jam estas registrita"

#: src/komandaro/registry.py:131
#, python-format
msgid "Unknown command %(id)s"
msgstr "Nekonata komando: %(id)s"

#: src/komandaro/schema.py:135
#, python-format
msgid "Unknown parameter %(name)s"
msgstr "Nekonata parametro: %(name)s"

#: src/komandaro/schema.py:142
#, python-format
msgid "Missing required parameter %(name)s"
msgstr "Mankas deviga parametro: %(name)s"

#: src/komandaro/schema.py:156
#, python-format
msgid "Invalid value for parameter %(name)s: %(error)s"
msgstr "Nevalida valoro por la parametro %(name)s: %(error)s"

